FROM python:3.11-slim
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir '.[worker]'
RUN useradd -m -u 10001 appuser && mkdir -p /data/objects && chown -R appuser /data
USER appuser
CMD ["celery","-A","app.worker:celery","worker","--loglevel=INFO","--concurrency=2"]
